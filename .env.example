# ============================================================
# Piaoshu Avatar OS - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values
# For Vercel deployment, set these in Vercel Dashboard → Settings → Environment Variables

# ── Database ──────────────────────────────────────────────
# LOCAL DEVELOPMENT (SQLite):
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# VERCEL DEPLOYMENT (Turso - SQLite-compatible cloud database):
# 1. Create a free Turso database at https://turso.tech
# 2. Run: turso db create piaoshu-avatar
# 3. Run: turso db show piaoshu-avatar --url  → get the URL
# 4. Run: turso db tokens create piaoshu-avatar → get the auth token
# DATABASE_URL="libsql://piaoshu-avatar-xxx.turso.io?authToken=xxx"

# ── Auth ──────────────────────────────────────────────────
NEXTAUTH_SECRET="piaoshu-founder-os-secret-key-v1"
NEXTAUTH_URL="http://localhost:3000"
# For Vercel: NEXTAUTH_URL="https://piaoshu-avatar.vercel.app"

# ── AI Skills (z-ai-web-dev-sdk) ──────────────────────────
# These are used by the backend API routes for AI capabilities
# ZAI_API_KEY="your-z-ai-api-key"

# ── Stripe (optional, for subscription payments) ──────────
# STRIPE_SECRET_KEY="sk_test_xxx"
# STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ── Vercel Detection ──────────────────────────────────────
# This is automatically set by Vercel, no need to configure
# VERCEL="1"
